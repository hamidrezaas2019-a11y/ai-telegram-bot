{
  "name": "ai-telegram-bot",
  "version": "10.0.0",
  "description": "🤖 ربات هوش مصنوعی پیشرفته تلگرام با ۱۱ موتور AI و ۱۳۶ شخصیت",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "db:init": "wrangler d1 execute ai_bot_db --file=./migrations/001_init.sql",
    "db:create": "wrangler d1 create ai_bot_db",
    "db:list": "wrangler d1 list",
    "db:info": "wrangler d1 info ai_bot_db",
    "db:seed": "wrangler d1 execute ai_bot_db --file=./migrations/seed.sql",
    "webhook:set": "curl -X GET https://ai-telegram-bot.hamidreza-as2019.workers.dev/set-webhook",
    "webhook:info": "curl https://ai-telegram-bot.hamidreza-as2019.workers.dev/webhook-info",
    "test": "echo \"No tests specified\"",
    "format": "prettier --write .",
    "lint": "eslint src/**/*.js"
  },
  "keywords": [
    "telegram",
    "ai",
    "bot",
    "gemini",
    "dall-e",
    "cloudflare",
    "worker",
    "nova"
  ],
  "author": "Hamidreza",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^3.114.17"
  },
  "dependencies": {
    "itty-router": "^4.2.2"
  }
}
