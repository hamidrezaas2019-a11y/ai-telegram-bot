{
  "name": "ai-telegram-bot",
  "main": "src/index.js",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-telegram-bot-db",
      "database_id": "YOUR_DATABASE_ID"
    }
  ],
  "vars": {
    "BOT_TOKEN": "توکن_ربات",
    "OPENAI_API_KEY": "کلید_اوپن‌ای",
    "GEMINI_API_KEY": "کلید_جمینی"
  }
}
